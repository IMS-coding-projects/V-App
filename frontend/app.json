{
    "expo": {
        "name": "OrariAperti",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/logo-oa-light.svg",
        "scheme": "minimal",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/images/logo-oa-dark.svg",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "edgeToEdgeEnabled": true,
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/logo-oa-dark.svg",
                "backgroundColor": "#ffffff"
            }
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.svg"
        },
        "plugins": ["expo-router"],
        "experiments": {
            "typedRoutes": true
        }
    }
}
